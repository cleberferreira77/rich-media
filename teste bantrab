  <script>
    function fitAd() {
      const viewportWidth = document.documentElement.clientWidth || window.innerWidth;
      const viewportHeight = document.documentElement.clientHeight || window.innerHeight;
      const scale = Math.min(viewportWidth / 1080, viewportHeight / 1920);
      document.documentElement.style.setProperty('--ad-scale', String(scale));
    }
    fitAd();
    addEventListener('resize', fitAd);
    if (window.visualViewport) visualViewport.addEventListener('resize', fitAd);
    window.clickTag = window.clickTag || '';
    const ad = document.getElementById('ad');
    function openClickTag() { if (window.clickTag) window.open(window.clickTag, '_blank', 'noopener'); }
    ad.addEventListener('click', openClickTag);
    ad.addEventListener('keydown', event => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); openClickTag(); } });
